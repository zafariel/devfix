:root {
    --bg: #080808;
    --surface: #111111;
    --surface-2: #101010;
    --input-bg: #050505;
    --text: #f5f5f5;
    --text-muted: #999999;
    --text-soft: #777777;
    --border: #222222;
    --border-soft: #181818;
    --accent: #ffffff;
    --accent-text: #000000;
    --shadow: rgba(0, 0, 0, 0.6);
}

