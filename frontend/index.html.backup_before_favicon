/* Theme system v2: all major analysis surfaces follow the active palette. */
:root {
    --panel-alpha: .78;
    --panel-bg: rgba(6,16,27,.78);
    --panel-bg-strong: rgba(6,16,27,.94);
    --line: var(--border);
    --heading: var(--text);
    --body-text: var(--muted);
    --chip-bg: color-mix(in srgb, var(--accent) 9%, transparent);
    --code-bg: color-mix(in srgb, var(--bg) 82%, #000 18%);
}

[data-theme="white"] {
    --panel-bg: rgba(255,255,255,.86);
    --panel-bg-strong: rgba(255,255,255,.96);
    --heading: #101a24;
    --body-text: #506274;
    --line: rgba(30,70,105,.16);
    --chip-bg: rgba(23,142,232,.09);
    --code-bg: #edf3f8;
}

/* Make the whole application inherit the active theme instead of retaining blue-only surfaces. */
body,
.app-shell,
.analyzer-stage,
.results,
.diagnostic-panel,
.health-card,
.score-card,
.info-panel,
.site-meta,
.preview-window,
.floating-panel,
.chat,
.url-console,
.issue-card,
.detail-list > div,
.theme-menu {
    color: var(--heading);
}

.diagnostic-panel,
.health-card,
.score-card,
.info-panel,
.site-meta,
.issue-card,
.preview-window,
.floating-panel,
.url-console,
.chat,
.detail-list > div {
    background: var(--panel-bg);
    border-color: var(--line);
}

.issue-card:hover,
.detail-list > div:hover {
    border-color: var(--border-strong);
    background: var(--panel-bg-strong);
}

.stage-copy h1,
.results-topline h2,
.panel-header h3,
.issue-title-row h4,
.tab-content h4,
.empty-state h3,
.score-core strong,
.summary-big strong {
    color: var(--heading);
}

.stage-copy p,
.issue-problem,
.issue-resolution p,
.tab-content p,
.empty-state p,
.meta-row span,
.detail-list span,
.site-meta .card-label,
.card-label,
.console-foot,
.health-card p {
    color: var(--body-text);
}

.meta-row strong,
.detail-list strong,
.issue-meta > span:not(.detail-chip) {
    color: var(--heading);
}

.code-block {
    background: var(--code-bg);
    border-color: var(--line);
}

.code-block code,
.detail-chip,
.analysis-tab.active,
.score-card .score-caption,
.issue-meta .detail-chip {
    color: var(--accent);
}

.theme-toggle {
    background: var(--panel-bg);
    color: var(--heading);
    border-color: var(--line);
}

.theme-toggle span { color: var(--accent); }

.theme-menu {
    background: var(--panel-bg-strong);
    border-color: var(--line);
    box-shadow: 0 22px 60px color-mix(in srgb, var(--shadow) 75%, transparent);
}

.theme-option {
    color: var(--heading);
}

.theme-option:hover,
.analysis-tab:hover {
    background: var(--chip-bg);
    color: var(--heading);
}

/* Textures are overlays, not replacements for the active color theme. */
body.custom-theme {
    background-image: linear-gradient(rgba(3,7,12,.58),rgba(3,7,12,.72)), var(--custom-background);
}

body.custom-theme[data-custom-theme="white"] {
    background-image: linear-gradient(rgba(255,255,255,.38),rgba(255,255,255,.58)), var(--custom-background);
}

/* White mode: dark labels/buttons so every theme control remains readable. */
[data-theme="white"] .theme-toggle,
[data-theme="white"] .theme-option,
[data-theme="white"] .custom-theme-toggle {
    color: #101a24;
}

[data-theme="white"] .theme-toggle span,
[data-theme="white"] .theme-option:hover,
[data-theme="white"] .analysis-tab.active {
    color: #0874c4;
}

[data-theme="white"] .custom-theme-option {
    color: #101a24;
    text-shadow: 0 1px 4px rgba(255,255,255,.9);
}

/* Theme-wide accents for controls, borders and focus states. */
input:focus,
button:focus-visible,
.url-console:focus-within,
.chat-input:focus-within {
    border-color: var(--border-strong);
    box-shadow: 0 0 0 3px var(--chip-bg), 0 0 28px color-mix(in srgb, var(--accent) 15%, transparent);
}

.primary-button,
.analyze-button,
.chat-send,
.chat-open {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
    box-shadow: 0 10px 28px color-mix(in srgb, var(--accent) 22%, transparent);
}

.secondary-button,
.analysis-tab.active {
    border-color: var(--border-strong);
}

[data-theme="white"] .primary-button,
[data-theme="white"] .analyze-button,
[data-theme="white"] .chat-send,
[data-theme="white"] .chat-open {
    color: #fff;
}

