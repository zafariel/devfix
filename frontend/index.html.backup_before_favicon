                    <div>
                        <span class="card-label">PROBLEMAS ENCONTRADOS</span>
                        <h3>O que precisa ser corrigido</h3>
                    </div>
                    <div id="issueCount" class="issue-count">0 problemas</div>
                </div>

                <div class="filter-row" id="issueFilters">
                    <button class="filter active" data-filter="all" type="button">Todos</button>
                    <button class="filter" data-filter="high" type="button">Alto</button>
                    <button class="filter" data-filter="medium" type="button">Médio</button>
                    <button class="filter" data-filter="low" type="button">Baixo</button>
                </div>

                <div id="issues" class="issues-list"></div>
            </div>

            <div class="details-grid">
                <article class="info-panel glass-card">
                    <div class="tabs" role="tablist">
                        <button class="analysis-tab active" data-tab="summary" type="button">Resumo</button>
                        <button class="analysis-tab" data-tab="details" type="button">Detalhes</button>
                        <button class="analysis-tab" data-tab="recommendations" type="button">Recomendações</button>
                    </div>
                    <div id="tabContent" class="tab-content"></div>
                </article>

                <article class="site-meta glass-card">
                    <span class="card-label">DADOS DA ANÁLISE</span>
                    <div class="meta-row"><span>Status HTTP</span><strong id="metaStatus">—</strong></div>
                    <div class="meta-row"><span>Content-Type</span><strong id="metaType">—</strong></div>
                    <div class="meta-row"><span>Título</span><strong id="metaTitle">—</strong></div>
                    <div class="meta-row"><span>Imagens</span><strong id="metaImages">—</strong></div>
                    <div class="meta-row"><span>Links</span><strong id="metaLinks">—</strong></div>
                </article>
            </div>
        </section>
    </main>

    <section id="chat" class="chat hidden" aria-label="Assistente DEVFIX">
        <div class="chat-header">
            <div><span class="eyebrow">DEVFIX ASSISTANT</span><h2>Entenda seu diagnóstico.</h2></div>
            <button id="closeChat" class="chat-close" type="button" aria-label="Fechar chat">×</button>
        </div>
        <div id="chatMessages" class="chat-messages">
            <div class="chat-message assistant"><strong>DEVFIX</strong><p>Posso explicar qualquer problema encontrado na análise e mostrar o que deve ser corrigido.</p></div>
        </div>
        <div class="chat-input"><input id="chatInput" type="text" name="message" placeholder="Pergunte sobre este diagnóstico..." autocomplete="on" aria-label="Mensagem para o assistente"><button id="chatButton" type="button">→</button></div>
    </section>
    <button id="openChat" class="chat-open" type="button" aria-label="Abrir chat">✦</button>

<script>
let currentAnalysis = null;
let currentFilter = "all";
let currentTab = "summary";

const chat = document.getElementById("chat");
const closeChat = document.getElementById("closeChat");
const openChat = document.getElementById("openChat");
const chatInput = document.getElementById("chatInput");
const chatButton = document.getElementById("chatButton");
const chatMessages = document.getElementById("chatMessages");

const button = document.getElementById("analyzeButton");
const input = document.getElementById("urlInput");
const status = document.getElementById("status");
const results = document.getElementById("results");
const issuesContainer = document.getElementById("issues");
const scoreElement = document.getElementById("score");
const scoreRing = document.getElementById("scoreRing");
const categoryGrid = document.getElementById("categoryGrid");
const issueCount = document.getElementById("issueCount");
const tabContent = document.getElementById("tabContent");
const resultsTitle = document.getElementById("resultsTitle");
const resultsUrl = document.getElementById("resultsUrl");
const newAnalysis = document.getElementById("newAnalysis");

const themeToggle = document.getElementById("themeToggle");
const themeMenu = document.getElementById("themeMenu");
const themeOptions = document.querySelectorAll(".theme-option");
const customThemeToggle = document.getElementById("customThemeToggle");
const customThemeMenu = document.getElementById("customThemeMenu");
const customThemeOptions = document.querySelectorAll(".custom-theme-option");

const severityLabels = { high: "Alto", medium: "Médio", low: "Baixo", alto: "Alto", médio: "Médio", baixo: "Baixo" };
const issueTypeLabels = { erro: "Erro", aviso: "Aviso", informação: "Informação" };
const categoryMap = {
    seo: { label: "SEO", icon: "⌁" },
    accessibility: { label: "Acessibilidade", icon: "◉" },
    html: { label: "HTML", icon: "</>" },
    css: { label: "Estilo", icon: "◇" },
    javascript: { label: "JavaScript", icon: "JS" },
    mobile: { label: "Mobile", icon: "⌁" },
    performance: { label: "Performance", icon: "◌" },
    security: { label: "Segurança", icon: "◇" }
};
const displayCategories = ["seo", "accessibility", "html", "performance", "security"];

function normalizeSeverity(value) {
    const raw = String(value ?? "").toLowerCase().trim();
    if (["high", "alto", "crítico", "critico"].includes(raw)) return "high";
    if (["medium", "médio", "medio", "atenção", "atencao"].includes(raw)) return "medium";
    return "low";
}

function calculateScore(issues) {
    let score = 100;
    for (const issue of issues) {
        const severityScore = Number(issue.score ?? 1);
        score -= Math.max(0, Math.min(10, severityScore - 1));
    }
    return Math.max(0, Math.round(score));
}

function getCategoryIssues(issues, category) {
    if (category === "html") {
        return issues.filter(i => ["html", "css", "javascript", "mobile"].includes(String(i.category || "").toLowerCase()));
    }
    return issues.filter(i => String(i.category || "").toLowerCase() === category);
}

function categoryState(categoryIssues) {
    if (!categoryIssues.length) return { label: "Bom", tone: "good" };
    const severities = categoryIssues.map(i => normalizeSeverity(i.severity));
    if (severities.includes("high")) return { label: "Crítico", tone: "bad" };
    if (severities.includes("medium")) return { label: "Atenção", tone: "warn" };
    return { label: "Atenção", tone: "warn" };
}

function analyze() {
    const url = input.value.trim();
    if (!url) {
        status.textContent = "Digite uma URL para começar.";
        input.focus();
        return;
    }

    if (window.location.protocol === "file:") {
        status.textContent = "Este arquivo é uma prévia visual. Para analisar sites de verdade, abra o DEVFIX pelo Flask em http://127.0.0.1:5000/.";
        status.classList.remove("loading");
        return;
    }

    status.textContent = "Analisando site...";
    status.classList.add("loading");
    button.disabled = true;
    button.classList.add("loading");
    results.classList.add("hidden");

    fetch("/analyze", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ url })
    })
        .then(async response => {
            const data = await response.json();
            if (!response.ok) throw new Error(data.error || "Erro ao analisar.");
            return data;
        })
        .then(data => {
            renderResults(data);
            status.textContent = "Análise concluída.";
            status.classList.remove("loading");
        })
        .catch(error => {
            console.error("Erro na análise:", error);
            status.textContent = error.message;
            status.classList.remove("loading");
        })
        .finally(() => {
            button.disabled = false;
            button.classList.remove("loading");
        });
}

button.addEventListener("click", analyze);
input.addEventListener("keydown", event => {
    if (event.key === "Enter") analyze();
});

const LAST_ANALYSIS_KEY = "devfix-last-analysis";

function saveLastAnalysis(data) {
    try {
        localStorage.setItem(LAST_ANALYSIS_KEY, JSON.stringify(data));
    } catch (error) {
        console.warn("Não foi possível salvar a última análise localmente:", error);
    }
}

function loadLastAnalysis() {
    try {
        const saved = localStorage.getItem(LAST_ANALYSIS_KEY);
        if (!saved) return null;

        const data = JSON.parse(saved);
        if (!data || typeof data !== "object") return null;
        return data;
    } catch (error) {
        console.warn("Não foi possível restaurar a última análise:", error);
        localStorage.removeItem(LAST_ANALYSIS_KEY);
        return null;
    }
}

function clearLastAnalysis() {
    localStorage.removeItem(LAST_ANALYSIS_KEY);
}

function renderResults(data, options = {}) {
    currentAnalysis = data;
    if (!options.restored) {
        saveLastAnalysis(data);
    }
    const issues = Array.isArray(data.issues) ? data.issues : [];
    const score = calculateScore(issues);

    results.classList.remove("hidden");
    if (options.restored) {
        chat.classList.remove("hidden");
        chat.style.display = "none";
        openChat.style.display = "flex";
    } else {
        chat.classList.remove("hidden");
        chat.style.display = "flex";
        openChat.style.display = "none";
    }

    resultsTitle.textContent = "Diagnóstico do site";
    resultsUrl.textContent = data.url || input.value.trim();
    scoreElement.textContent = score;
    scoreRing.style.setProperty("--score", score);
    document.getElementById("metaStatus").textContent = data.status_code ?? "—";
    document.getElementById("metaType").textContent = data.content_type || "—";
    document.getElementById("metaTitle").textContent = data.html?.title || "Não encontrado";
    document.getElementById("metaImages").textContent = data.html?.images ?? "—";
    document.getElementById("metaLinks").textContent = data.html?.links ?? "—";
    issueCount.textContent = `${issues.length} ${issues.length === 1 ? "problema" : "problemas"}`;

    document.getElementById("scoreCaption").textContent = score >= 90
        ? "Excelente base. Poucos pontos precisam de atenção."
        : score >= 70
            ? "Boa base, mas existem pontos que merecem atenção."
            : score >= 40
                ? "Existem problemas relevantes que devem ser priorizados."
                : "O site apresenta problemas importantes que precisam de correção.";

    renderCategories(issues);
    renderIssues(issues);
    renderTab(currentTab);

    results.scrollIntoView({ behavior: "smooth", block: "start" });
}

function renderCategories(issues) {
    categoryGrid.innerHTML = displayCategories.map(category => {
        const info = categoryMap[category];
        const state = categoryState(getCategoryIssues(issues, category));
        return `<div class="category-item">
            <div class="category-icon">${escapeHtml(info.icon)}</div>
            <div class="category-copy"><span>${escapeHtml(info.label)}</span><strong class="${state.tone}">${escapeHtml(state.label)}</strong></div>
            <div class="category-dot ${state.tone}"></div>
        </div>`;
    }).join("");
}

function renderIssues(issues) {
    const filtered = currentFilter === "all"
        ? issues
        : issues.filter(issue => normalizeSeverity(issue.severity) === currentFilter);

    if (!filtered.length) {
        issuesContainer.innerHTML = `<div class="empty-state"><div class="empty-icon">✓</div><h3>${issues.length ? "Nenhum problema neste filtro" : "Nenhum problema encontrado"}</h3><p>${issues.length ? "Altere o filtro para visualizar outros resultados." : "O DEVFIX não encontrou problemas nas verificações atuais."}</p></div>`;
        return;
    }

    issuesContainer.innerHTML = filtered.map((issue, index) => {
        const severity = normalizeSeverity(issue.severity);
        const severityLabel = severityLabels[String(issue.severity || "").toLowerCase()] || severityLabels[severity];
        const typeLabel = issueTypeLabels[issue.type] || issue.type || "Não definido";
        const category = categoryMap[String(issue.category || "").toLowerCase()]?.label || issue.category || "Geral";
        const sourceLine = issue.line ? `<span class="detail-chip">Linha ${escapeHtml(issue.line)}</span>` : "";
        const multipleLines = Array.isArray(issue.lines) && issue.lines.length > 1 ? `<span class="detail-chip">Linhas ${escapeHtml(issue.lines.join(", "))}</span>` : "";
        const aiComment = `<div class="ai-note"><span>✦ ANÁLISE CLAUDE</span><p>${issue.ai_comment ? escapeHtml(issue.ai_comment) : "A análise Claude aparecerá aqui quando a integração estiver ativa."}</p></div>`;
        const example = issue.example ? `<div class="code-block"><span>EXEMPLO DE CORREÇÃO</span><code>${escapeHtml(issue.example)}</code></div>` : "";

        return `<article class="issue-card ${severity}" data-severity="${severity}">
            <div class="issue-marker"><i></i></div>
            <div class="issue-content">
                <div class="issue-title-row">
                    <div><span class="issue-index">${String(index + 1).padStart(2, "0")}</span><h4>${escapeHtml(issue.message || "Problema encontrado")}</h4></div>
                    <span class="severity-pill ${severity}">${escapeHtml(severityLabel)}</span>
                </div>
                <p class="issue-problem">${escapeHtml(issue.problem || "")}</p>
                <div class="issue-meta"><span>${escapeHtml(typeLabel)}</span><span>${escapeHtml(category)}</span>${sourceLine}${multipleLines}</div>
                <div class="issue-resolution"><div><span>COMO MELHORAR</span><p>${escapeHtml(issue.recommendation || "")}</p></div>${example}</div>
                ${aiComment}
            </div>
        </article>`;
    }).join("");
}

function renderTab(tab) {
    if (!currentAnalysis) return;
    const issues = currentAnalysis.issues || [];
    const score = calculateScore(issues);

    if (tab === "summary") {
        tabContent.innerHTML = `<div class="tab-summary"><div class="summary-big"><strong>${issues.length}</strong><span>pontos encontrados</span></div><div><h4>O que isso significa?</h4><p>O diagnóstico reúne problemas reais detectados no HTML recebido. Priorize os itens de maior severidade e use a recomendação de cada card como guia de correção.</p></div><div><h4>Pontuação atual</h4><p>${score}/100. A pontuação é calculada a partir das penalidades dos checks encontrados.</p></div></div>`;
    } else if (tab === "details") {
        const title = currentAnalysis.html?.title || "Não encontrado";
        const description = currentAnalysis.html?.description || "Não encontrada";
        tabContent.innerHTML = `<div class="detail-list"><div><span>URL final</span><strong>${escapeHtml(currentAnalysis.url || "—")}</strong></div><div><span>Título</span><strong>${escapeHtml(title)}</strong></div><div><span>Meta description</span><strong>${escapeHtml(description)}</strong></div><div><span>Status HTTP</span><strong>${escapeHtml(currentAnalysis.status_code ?? "—")}</strong></div></div>`;
    } else {
        const recommendations = issues.map(issue => issue.recommendation).filter(Boolean).filter((value, index, arr) => arr.indexOf(value) === index).slice(0, 8);
        tabContent.innerHTML = recommendations.length ? `<div class="recommendation-list">${recommendations.map((item, index) => `<div><b>${String(index + 1).padStart(2, "0")}</b><p>${escapeHtml(item)}</p></div>`).join("")}</div>` : `<div class="empty-tab"><h4>Nenhuma recomendação necessária</h4><p>Não há recomendações adicionais para os checks atuais.</p></div>`;
    }
}

document.querySelectorAll(".filter").forEach(filter => {
    filter.addEventListener("click", () => {
        currentFilter = filter.dataset.filter;
        document.querySelectorAll(".filter").forEach(item => item.classList.remove("active"));
        filter.classList.add("active");
        renderIssues(currentAnalysis?.issues || []);
    });
});

document.querySelectorAll(".analysis-tab").forEach(tab => {
    tab.addEventListener("click", () => {
        currentTab = tab.dataset.tab;
        document.querySelectorAll(".analysis-tab").forEach(item => item.classList.remove("active"));
        tab.classList.add("active");
        renderTab(currentTab);
    });
});

newAnalysis.addEventListener("click", () => {
    clearLastAnalysis();
    currentAnalysis = null;
    results.classList.add("hidden");
    chat.style.display = "none";
    openChat.style.display = "flex";
    status.textContent = "";
    input.value = "";
    input.focus();
    window.scrollTo({ top: 0, behavior: "smooth" });
});

function escapeHtml(value) {
    const div = document.createElement("div");
    div.textContent = String(value ?? "");
    return div.innerHTML;
}

closeChat.addEventListener("click", () => {
    chat.style.display = "none";
    openChat.style.display = "flex";
});
openChat.addEventListener("click", () => {
    chat.style.display = "flex";
    openChat.style.display = "none";
});
chatButton.addEventListener("click", sendChatMessage);
chatInput.addEventListener("keydown", event => {
    if (event.key === "Enter") sendChatMessage();
});

async function sendChatMessage() {
    const message = chatInput.value.trim();
    if (!message) return;
    addChatMessage("Você", message);
    chatInput.value = "";
    chatInput.disabled = true;
    chatButton.disabled = true;
    try {
        const response = await fetch("/api/chat", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ message, context: currentAnalysis }) });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || "Erro ao consultar a IA.");
        addChatMessage("DEVFIX", data.response);
    } catch (error) {
        console.error("Erro no chat:", error);
        addChatMessage("DEVFIX", "Não foi possível obter uma resposta da IA no momento.");
    } finally {
        chatInput.disabled = false;
        chatButton.disabled = false;
        chatInput.focus();
    }
}

function addChatMessage(author, text) {
    const div = document.createElement("div");
    div.className = author === "Você" ? "chat-message user" : "chat-message assistant";
    div.innerHTML = `<strong>${escapeHtml(author)}</strong><p>${escapeHtml(text)}</p>`;
    chatMessages.appendChild(div);
    chatMessages.scrollTop = chatMessages.scrollHeight;
}

let isDragging = false;
let offsetX = 0;
let offsetY = 0;
const chatHeader = document.querySelector(".chat-header");
chatHeader.addEventListener("pointerdown", event => {
    if (event.target.closest("#closeChat")) return;
    isDragging = true;
    const rect = chat.getBoundingClientRect();
    offsetX = event.clientX - rect.left;
    offsetY = event.clientY - rect.top;
    chat.style.right = "auto";
    chat.style.bottom = "auto";
    chatHeader.setPointerCapture(event.pointerId);
});
chatHeader.addEventListener("pointermove", event => {
    if (!isDragging) return;
    chat.style.left = `${event.clientX - offsetX}px`;
    chat.style.top = `${event.clientY - offsetY}px`;
});
chatHeader.addEventListener("pointerup", event => {
    isDragging = false;
    if (chatHeader.hasPointerCapture(event.pointerId)) chatHeader.releasePointerCapture(event.pointerId);
});
chatHeader.addEventListener("pointercancel", () => { isDragging = false; });

const customThemeBackgrounds = {
    black: "/static/themes/custom/2196afa9babcb4faf730e241a5dd3cad.jpg",
    white: "/static/themes/custom/e762fd01e73aac3a3ffad734fbec0979.jpg",
    red: "/static/themes/custom/a603143cd5568406be843e976924697f.jpg",
    blue: "/static/themes/custom/6c8158d7512985ff5726186bd848c036.jpg",
    green: "/static/themes/custom/b24f896d5c33a611df0497d93d192862.jpg",
    purple: "/static/themes/custom/2d83c9c59df963b2d7162abd0981c0e0.jpg",
    orange: "/static/themes/custom/8282658b5da529a017af50d45c3d303d.jpg",
    pink: "/static/themes/custom/77889a56dc8bc57b9d7903847cd29634.jpg",
    cyan: "/static/themes/custom/6273d9cfd1b83372e3a9902eb3b63420.jpg",
    gold: "/static/themes/custom/a72425545b2532c22cc447b64c121d9a.jpg"
};

themeToggle.addEventListener("click", () => {
    themeMenu.classList.toggle("hidden");
    customThemeMenu.classList.add("hidden");
});
customThemeToggle.addEventListener("click", () => {
    customThemeMenu.classList.toggle("hidden");
    themeMenu.classList.add("hidden");
});

document.addEventListener("click", event => {
    if (!event.target.closest(".theme-picker")) {
        themeMenu.classList.add("hidden");
        customThemeMenu.classList.add("hidden");
    }
});

function setBaseTheme(theme) {
    if (theme === "black") document.documentElement.setAttribute("data-theme", "black");
    else document.documentElement.setAttribute("data-theme", theme);
}
function applyTheme(theme) {
    setBaseTheme(theme);
    document.body.classList.remove("custom-theme");
    delete document.body.dataset.customTheme;
    document.documentElement.style.removeProperty("--custom-background");
    localStorage.setItem("devfix-theme", theme);
    localStorage.removeItem("devfix-custom-theme");
}
themeOptions.forEach(option => option.addEventListener("click", () => {
    applyTheme(option.dataset.themeOption);
    themeMenu.classList.add("hidden");
}));
function applyCustomTheme(theme) {
    const background = customThemeBackgrounds[theme];
    if (!background) return;
    setBaseTheme(theme);
    document.documentElement.style.setProperty("--custom-background", `url("${background}")`);
    document.body.classList.add("custom-theme");
    document.body.dataset.customTheme = theme;
    localStorage.setItem("devfix-custom-theme", theme);
    localStorage.removeItem("devfix-theme");
}
customThemeOptions.forEach(option => option.addEventListener("click", () => {
    applyCustomTheme(option.dataset.customTheme);
    customThemeMenu.classList.add("hidden");
}));

const savedCustomTheme = localStorage.getItem("devfix-custom-theme");
const savedTheme = localStorage.getItem("devfix-theme");
if (savedCustomTheme) applyCustomTheme(savedCustomTheme);
else if (savedTheme) applyTheme(savedTheme);


// Restaura automaticamente a última análise depois de recarregar a página
// ou reiniciar o servidor. O resultado fica salvo apenas no navegador.
const restoredAnalysis = loadLastAnalysis();
if (restoredAnalysis) {
    if (restoredAnalysis.url) {
        input.value = restoredAnalysis.url;
    }
    renderResults(restoredAnalysis, { restored: true });
    status.textContent = "Última análise restaurada.";
    status.classList.remove("loading");
}

</script>
</body>
</html>
