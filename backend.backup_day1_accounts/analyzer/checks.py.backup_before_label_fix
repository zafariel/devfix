    # ============================================================

    stylesheet_without_href = []

    for link in soup.find_all("link"):
        rel = link.get("rel", [])
        rel_values = [str(value).lower() for value in rel]

        if "stylesheet" in rel_values and not link.get("href"):
            stylesheet_without_href.append(link)

    if stylesheet_without_href:
        issues.append(_issue(
            check=98,
            issue_type="erro",
            severity="médio",
            category="css",
            message=f"{len(stylesheet_without_href)} stylesheet(s) sem href.",
