    # ============================================================

    external_blank_links = []

    for link in soup.find_all("a", href=True):
        href = link.get("href", "").strip().lower()
        target = link.get("target", "").strip().lower()

        if target == "_blank" and href.startswith(("http://", "https://")):
            rel = link.get("rel", [])
            rel_values = [str(value).lower() for value in rel]

            if "noopener" not in rel_values:
                external_blank_links.append(link)

    if external_blank_links:
        issues.append(_issue(
            check=94,
            issue_type="aviso",
            severity="médio",
            category="security",
            message=f"{len(external_blank_links)} link(s) externo(s) com target=\"_blank\" sem noopener.",
