    # ============================================================

    favicon = None

    for link in soup.find_all("link"):
        rel = link.get("rel", [])
        rel_values = [str(value).lower() for value in rel]

        if "icon" in rel_values:
            favicon = link
            break

    if not favicon:
        issues.append(_issue(
            check=99,
