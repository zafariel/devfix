        # Um nome acessível explícito já identifica o campo.
        if aria_label or aria_labelledby:
            continue

        # Uma label pode envolver diretamente o próprio input,
        # mesmo quando o input não possui id.
        wrapping_label = input_element.find_parent("label")
        if wrapping_label:
            continue

        # Sem id, não existe como verificar uma associação label[for].
        if not input_id:
            inputs_without_label.append(input_element)
            continue

        label = soup.find("label", attrs={"for": input_id})

        if not label:
            inputs_without_label.append(input_element)

    if inputs_without_label:
