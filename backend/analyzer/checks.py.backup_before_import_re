from bs4 import BeautifulSoup
from urllib.parse import urlparse
import inspect


_CURRENT_SOUP = None


def _tag_lines(value):
    """
    Extrai as linhas de elementos BeautifulSoup encontrados durante o check.
    Aceita:
      - Tag
      - lista/tupla/conjunto de Tags
    """
    lines = []

    if value is None:
        return lines

    if hasattr(value, "sourceline"):
        line = getattr(value, "sourceline", None)
        if isinstance(line, int) and line > 0:
            lines.append(line)
        return lines

    if isinstance(value, (list, tuple, set)):
        for item in value:
            if hasattr(item, "sourceline"):
                line = getattr(item, "sourceline", None)
                if isinstance(line, int) and line > 0:
                    lines.append(line)

    return lines


def _find_source_lines(soup, category, message, problem, recommendation):
    """
    Tenta localizar, no HTML real analisado, os elementos relacionados
    ao problema detectado.

    A função não altera nenhum check existente.
    """

    frame = inspect.currentframe()
    caller = frame.f_back if frame else None

    try:
        if caller:
            local_vars = caller.f_locals

            # O check normalmente acabou de criar uma variável contendo
            # exatamente o elemento/lista relacionado ao problema.
            candidates = []

            for name, value in local_vars.items():
                if name in {
                    "soup",
                    "issues",
                    "html",
                    "url",
                    "category",
                    "message",
                    "problem",
                    "recommendation",
                }:
                    continue

                lines = _tag_lines(value)

                if lines:
                    # Variáveis criadas mais especificamente para o problema
                    # recebem preferência.
                    score = 0
                    name_lower = name.lower()

                    text = " ".join([
                        str(category or ""),
                        str(message or ""),
                        str(problem or ""),
                        str(recommendation or ""),
                    ]).lower()

                    keywords = [
                        "image", "imagem", "img",
                        "title", "título",
                        "description", "descrição",
                        "h1", "h2", "h3", "h4", "h5", "h6",
                        "link", "a href", "âncora",
                        "script",
                        "style", "css",
                        "form", "input", "button", "botão",
                        "video", "audio",
                        "iframe",
                        "meta",
                        "canonical", "robots",
                        "header", "footer", "main",
                        "nav", "section", "article",
                        "html", "head", "body",
                    ]

                    for keyword in keywords:
                        if keyword in name_lower and keyword in text:
                            score += 10

                    # Listas de elementos são especialmente úteis para
                    # checks que encontram vários problemas.
                    if isinstance(value, (list, tuple, set)):
                        score += 2

                    candidates.append((score, name, lines))

            if candidates:
                candidates.sort(key=lambda item: item[0], reverse=True)

                best_lines = candidates[0][2]

                if best_lines:
                    return sorted(set(best_lines))

    finally:
        del caller
        del frame

    # ------------------------------------------------------------
    # FALLBACK PARA PROBLEMAS DE ELEMENTO AUSENTE
    # ------------------------------------------------------------

    category_text = str(category or "").lower()
    text = " ".join([
        str(message or ""),
        str(problem or ""),
        str(recommendation or ""),
    ]).lower()

    # Quando o elemento que deveria existir não existe, apontamos
    # para o container HTML correto onde ele deveria estar.
    if any(word in text for word in [
        "title",
        "título",
        "meta description",
        "description",
        "charset",
        "canonical",
        "robots",
        "viewport",
        "head",
    ]):
        container = soup.find("head")
        if container and getattr(container, "sourceline", None):
            return [container.sourceline]

    if any(word in text for word in [
        "main",
        "header",
        "footer",
        "nav",
        "section",
        "article",
        "body",
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6",
        "form",
        "button",
        "input",
        "imagem",
        "image",
        "acessibilidade",
    ]):
        container = soup.find("body") or soup.find("html")
        if container and getattr(container, "sourceline", None):
            return [container.sourceline]

    container = soup.find("html")
    if container and getattr(container, "sourceline", None):
        return [container.sourceline]

    return []


def _get_source_lines(source):
    """
    Retorna as linhas reais do HTML correspondentes
    aos elementos encontrados pelo BeautifulSoup.
    """
    if source is None:
        return []

    if isinstance(source, (list, tuple, set)):
        elements = source
    else:
        elements = [source]

    lines = []

    for element in elements:
        line = getattr(element, "sourceline", None)

        if isinstance(line, int) and line > 0:
            lines.append(line)

    return sorted(set(lines))


def _issue(
    check,
    issue_type,
    severity,
    category,
    message,
    problem,
    recommendation,
    example=None,
    score=1,
    source=None,
):
    issue = {
        "check": check,
        "type": issue_type,
        "severity": severity,
        "category": category,
        "message": message,
        "problem": problem,
        "recommendation": recommendation,
        "score": score,
    }

    if example:
        issue["example"] = example

    lines = _get_source_lines(source)

    if lines:
        issue["line"] = lines[0]

        if len(lines) > 1:
            issue["lines"] = lines

    return issue


